{"id":"int-cc080f68fba5ebddee32e643bf476ffb","kind":"field_change","created_at":"2026-09-18T13:56:22.813351065Z","actor":"Anthony Green","issue_id":"scute-ltf","extra":{"field":"status","new_value":"closed","old_value":"open","reason":"Done: keyfence now has -api-key-file, and reads $CREDENTIALS_DIRECTORY/api-key without being asked so systemd LoadCredential works (keyfence commit bfde53c). The shipped unit uses it."}}
