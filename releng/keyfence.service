# A credential broker for sandboxed agents, as a user service.
#
# SPDX-License-Identifier: MIT
#
# Install:
#     mkdir -p ~/.config/systemd/user
#     cp releng/keyfence.service ~/.config/systemd/user/
#     systemctl --user enable --now keyfence
#
# Scute attaches to whatever is already answering on the control port, so with
# this running a brokered sandbox costs no broker startup, and the CA the
# agent's runtimes trust stays the same between runs.
#
# The proxy and SSH listeners are loopback-only. Control uses a private Unix
# socket; Scute confines every Unix-enabled sandbox with Landlock ABI 9 so that
# sharing the host UID cannot give the command access to this control socket.

[Unit]
Description=KeyFence credential broker
Documentation=https://github.com/atgreen/keyfence
After=network.target

[Service]
Type=simple

# A private Unix listener authenticated by peer UID; no control secret in argv.
RuntimeDirectory=keyfence
RuntimeDirectoryMode=0700
ExecStart=keyfence -proxy 127.0.0.1:10210 -api unix:%t/keyfence/control.sock -api-allow-uid %U -ssh 127.0.0.1:10211 -data-dir %h/.keyfence

Restart=on-failure
RestartSec=2

# This process holds the real credentials, which is the whole point of it: it
# should be able to do less than the agent it is protecting, not more.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.keyfence
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=default.target
